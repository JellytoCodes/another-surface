<Window x:Class="Vellume.App.VideoRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영상 재생 구간" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        Icon="pack://application:,,,/Vellume.App;component/Assets/Brand/vellume-app.ico">
    <StackPanel Margin="24">
        <TextBlock x:Name="VideoName" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="DurationLabel" Margin="0,10,0,18"/>
        <CheckBox x:Name="RangeEnabled" Content="선택한 시간 구간만 반복 재생" Margin="0,0,0,18"/>
        <Grid IsEnabled="{Binding IsChecked, ElementName=RangeEnabled}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="시작 (초)" Margin="0,0,0,8"/>
                <TextBox x:Name="StartSeconds" FontSize="18" Padding="10" Foreground="Black" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="종료 (초)" Margin="0,0,0,8"/>
                <TextBox x:Name="EndSeconds" FontSize="18" Padding="10" Foreground="Black" Background="White"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="예: 10 ~ 30 → 해당 20초를 반복합니다. 소수점 입력 가능.&#x0a;체크를 해제하면 영상 전체를 반복합니다."
                   Margin="0,14,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ValidationError" Foreground="#FF91AC" TextWrapping="Wrap" MinHeight="35" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="저장" IsDefault="True" Click="Save_Click" Background="{StaticResource AccentBrush}"/>
        </StackPanel>
        <TextBlock Text="저장 후 라이브러리의 ‘적용’을 누르면 해당 화면에 반영됩니다."
                   Margin="0,12,0,0" FontSize="12"/>
    </StackPanel>
</Window>
