<Window x:Class="Vellume.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vellume"
        Icon="pack://application:,,,/Assets/Brand/vellume-app.ico"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0D111A"
                BorderBrush="#202635"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="VELLUME"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="라이브 데스크톱 · 0.9.0"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavigationButton}"
                                Content="⌂   홈"
                            Click="HomeNavigation_Click"/>
                    <Button Style="{StaticResource NavigationButton}"
                                Content="▦   라이브러리"
                            Click="LibraryNavigation_Click"/>
                    <Button Style="{StaticResource NavigationButton}"
                                Content="⌁   위젯"
                            Click="WidgetsNavigation_Click"/>
                    <Button Style="{StaticResource NavigationButton}"
                                Content="⚙   설정"
                            Click="SettingsNavigation_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="월페이퍼 상태"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="SidebarStatusText"
                                       Text="중지됨"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Vellume 종료"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            Background="#522A35"
                            Foreground="#FFF1F4"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28">
            <Grid x:Name="HomePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="홈" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="모니터를 선택해 라이브러리 월페이퍼를 적용하고, 화면별 재생 상태를 제어합니다."
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14"/>
                    <TextBlock x:Name="HomeStatusText"
                               Text="라이브러리에서 월페이퍼를 추가하세요."
                               Margin="0,7,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"/>
                    <TextBlock x:Name="NowPlayingText"
                               Text="활성 월페이퍼 없음"
                               Visibility="Collapsed"/>
                </StackPanel>

                <ListBox x:Name="DisplayList"
                         Grid.Row="2"
                         SelectionChanged="DisplayList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72"
                                            Height="44"
                                            CornerRadius="5"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="2"
                                            Background="#171C2B">
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="16"/>
                                            <TextBlock Text="{Binding WallpaperStatusLabel, StringFormat= · {0}}"
                                                       Margin="8,2,0,0"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Width}"/>
                                            <Run Text=" × "/>
                                            <Run Text="{Binding Height}"/>
                                            <Run Text=" 픽셀"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="#FFFFFF"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding AssignedWallpaperName, StringFormat=월페이퍼 · {0}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="18,0,0,0">
                                        <Button Content="{Binding PauseButtonLabel}"
                                                Tag="{Binding}"
                                                Click="DisplayPauseButton_Click"
                                                IsEnabled="{Binding HasAssignedWallpaper}"
                                                MinWidth="82"
                                                Margin="0,0,8,0"/>
                                        <Button Content="중지"
                                                Tag="{Binding}"
                                                Click="DisplayStopButton_Click"
                                                IsEnabled="{Binding HasAssignedWallpaper}"
                                                MinWidth="68"
                                                Background="#522A35"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="전체 월페이퍼 제어"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="모든 모니터의 월페이퍼 렌더러를 제거하고 Windows 배경화면으로 돌아갑니다."
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Content="모두 중지"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="StopAllButton_Click"
                                Background="#522A35"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="LibraryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                                <TextBlock Text="라이브러리" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="등록한 이미지, GIF, MP4/WebM 영상과 로컬 HTML을 Vellume 저장소에서 관리합니다."
                                   Margin="0,7,12,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="+ 파일 추가"
                                Click="AddFileButton_Click"
                                Margin="0,0,8,0"/>
                                <Button Content="+ HTML 폴더 추가"
                                Click="AddFolderButton_Click"
                                Background="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14">
                    <Button Content="전체" Tag="All" Click="LibraryFilter_Click" Margin="0,0,8,0" Background="{StaticResource AccentBrush}"/>
                    <Button Content="이미지" Tag="Image" Click="LibraryFilter_Click" Margin="0,0,8,0"/>
                    <Button Content="영상" Tag="Video" Click="LibraryFilter_Click" Margin="0,0,8,0"/>
                    <Button Content="GIF" Tag="Gif" Click="LibraryFilter_Click" Margin="0,0,8,0"/>
                    <Button Content="웹" Tag="Web" Click="LibraryFilter_Click" Margin="0,0,14,0"/>
                    <TextBlock x:Name="LibraryFilterLabel" Text="전체 보기" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="LibraryList"
                         Grid.Row="2"
                         MouseDoubleClick="LibraryList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="17">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="100"
                                            Height="64"
                                            CornerRadius="8"
                                            Background="#2A3150">
                                        <Grid>
                                            <TextBlock Text="{Binding KindLabel}" Foreground="#BEC8D1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=WallpaperThumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image x:Name="WallpaperThumbnail" Stretch="Uniform" Loaded="WallpaperThumbnail_Loaded"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StorageLabel}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding VideoRangeLabel}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="재생 구간" Click="VideoRangeButton_Click" Tag="{Binding}" Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KindLabel}" Value="영상">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                                    <Button Content="적용"
                                                Click="ApplyCardButton_Click"
                                                Tag="{Binding}"
                                                Background="{StaticResource AccentBrush}"
                                                Margin="0,0,8,0"/>
                                                    <Button Content="삭제"
                                                Click="RemoveCardButton_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="WidgetsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                                <TextBlock Text="위젯" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="월페이퍼를 바꾸거나 중지해도 유지되는 독립 HUD 레이어입니다."
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Height="150"
                                Background="#070D15"
                                BorderBrush="#285A76"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="02:41"
                                               FontFamily="Consolas"
                                               FontSize="43"
                                               Foreground="#B9FFFF"/>
                                            <TextBlock Text="2026년 7월 26일 · 일요일"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Foreground="#66DCE8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Width="230"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="시스템 정보"
                                               FontFamily="Consolas"
                                               Foreground="#8FEAF5"
                                               FontWeight="Bold"/>
                                            <TextBlock Text="CPU  18%      메모리  42%"
                                               Margin="0,9,0,0"
                                               FontFamily="Consolas"
                                               Foreground="#D8FAFF"/>
                                    <Border Height="5"
                                            Margin="0,7,0,0"
                                            Background="#163341"
                                            CornerRadius="3">
                                        <Border Width="105"
                                                HorizontalAlignment="Left"
                                                Background="#32DDE5"
                                                CornerRadius="3"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Padding="22">
                            <StackPanel>
                                <CheckBox x:Name="WidgetsEnabledCheckBox"
                                      Content="데스크톱 위젯 사용"
                                          FontWeight="SemiBold"
                                          Checked="WidgetCheckBox_Changed"
                                          Unchecked="WidgetCheckBox_Changed"/>
                                <WrapPanel Margin="0,18,0,0">
                                    <CheckBox x:Name="ClockWidgetCheckBox"
                                      Content="시계와 날짜"
                                              Margin="0,0,26,0"
                                              Checked="WidgetCheckBox_Changed"
                                              Unchecked="WidgetCheckBox_Changed"/>
                                    <CheckBox x:Name="SystemWidgetCheckBox"
                                      Content="CPU, GPU, 메모리와 디스크"
                                              Margin="0,0,26,0"
                                              Checked="WidgetCheckBox_Changed"
                                              Unchecked="WidgetCheckBox_Changed"/>
                                    <CheckBox x:Name="QuickSlotsWidgetCheckBox"
                                      Content="퀵슬롯"
                                              Visibility="Collapsed"
                                              Margin="0,0,26,0"
                                              Checked="WidgetCheckBox_Changed"
                                              Unchecked="WidgetCheckBox_Changed"/>
                                    <CheckBox x:Name="CodexCompanionWidgetCheckBox"
                                      Content="Codex 컴패니언"
                                              Checked="WidgetCheckBox_Changed"
                                              Unchecked="WidgetCheckBox_Changed"/>
                                </WrapPanel>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="시계 위치"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <ComboBox x:Name="ClockSideComboBox"
                                              Grid.Column="1"
                                              SelectionChanged="WidgetPlacement_Changed"/>
                                    <TextBlock Grid.Column="3"
                                                   Text="시스템 정보 위치"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <ComboBox x:Name="SystemSideComboBox"
                                              Grid.Column="4"
                                              SelectionChanged="WidgetPlacement_Changed"/>
                                </Grid>
                                <Border Margin="0,10,0,0"
                                        Padding="16"
                                        Background="#141E2C"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                        <TextBlock Text="Codex 상태 연결 · 좌측 상단 고정"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock x:Name="CodexBridgeStatusText"
                                                   Text="실행 여부와 작업 활동은 자동 감지합니다. 상세 작업 단계가 필요할 때만 선택 연결을 설치하세요."
                                                       Margin="0,5,20,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="상세 상태 연결"
                                                Click="InstallCodexBridgeButton_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Padding="22">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Vellume Dock"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="고정 앱과 실행 중인 창을 하단 중앙에서 실행·전환합니다."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DockEnabledCheckBox"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Content="Dock 사용"
                                              Checked="DockSettings_Changed"
                                              Unchecked="DockSettings_Changed"/>
                                </Grid>
                                <WrapPanel Margin="0,16,0,0">
                                    <CheckBox x:Name="DockRunningAppsCheckBox"
                                              Content="실행 중인 앱 자동 표시"
                                              Checked="DockSettings_Changed"
                                              Unchecked="DockSettings_Changed"/>
                                    <CheckBox x:Name="WindowsTaskbarVisibleCheckBox"
                                              Content="Windows 작업표시줄 표시"
                                              Margin="22,0,0,0"
                                              Checked="DockSettings_Changed"
                                              Unchecked="DockSettings_Changed"/>
                                </WrapPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="아이콘 크기"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <ComboBox x:Name="DockIconSizeComboBox"
                                              Grid.Column="1"
                                              SelectionChanged="DockSettings_Changed"/>
                                    <TextBlock Grid.Column="3"
                                               Text="하단 여백"
                                               VerticalAlignment="Center"
                                               Margin="0,0,9,0"/>
                                    <ComboBox x:Name="DockBottomMarginComboBox"
                                              Grid.Column="4"
                                              SelectionChanged="DockSettings_Changed"/>
                                </Grid>
                                <TextBlock Text="Dock은 일반 앱 뒤로 내려갑니다. 필요할 때 Alt + `(숫자 1 왼쪽 키)로 앞으로 불러올 수 있습니다. 작업표시줄 표시를 끄면 Vellume 실행 중 숨겨지고 종료·비정상 종료 감지 시 복원됩니다."
                                           Margin="0,13,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="#F2C97D"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,12"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12"
                                Padding="22">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Dock 고정 앱"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="HotkeyStatusText"
                                                   Text="Dock에서 드래그해 순서를 바꾸고, 우클릭해 고정하거나 제거할 수 있습니다."
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                        <Button Content="앱 자동 찾기"
                                                Click="DiscoverKnownAppsButton_Click"
                                                Margin="0,0,8,0"/>
                                        <Button Content="+ 새 그룹"
                                                Visibility="Collapsed"
                                                Click="AddQuickSlotGroupButton_Click"
                                                Margin="0,0,8,0"/>
                                        <Button Content="+ 대상 추가"
                                                Click="AddQuickSlotButton_Click"
                                                Background="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Grid>

                                    <TextBlock Text="기존 퀵슬롯 앱은 Dock으로 이전됩니다. 실행 중인 앱은 우클릭해 고정하고, 고정 앱은 우클릭해 Dock에서 제거할 수 있습니다."
                                           Margin="0,15,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"/>
                                <TextBlock x:Name="KnownAppsStatusText"
                                               Text="설치된 주요 앱을 찾아 Dock 고정 목록에 추가합니다."
                                           Margin="0,-5,0,12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,12"
                                            Visibility="Collapsed">
                                    <CheckBox x:Name="SnapQuickSlotsCheckBox"
                                              Content="그룹을 그리드에 맞춤"
                                              VerticalAlignment="Center"
                                              Checked="GridSettings_Changed"
                                              Unchecked="GridSettings_Changed"/>
                                        <TextBlock Text="그리드 크기"
                                               Margin="24,0,9,0"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="QuickSlotGridSizeComboBox"
                                              Width="90"
                                              SelectionChanged="GridSettings_Changed"/>
                                        <TextBlock Text="픽셀"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                        <TextBlock Text="대상 그룹"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <ComboBox x:Name="QuickSlotGroupComboBox"
                                              Grid.Column="1"
                                              DisplayMemberPath="Name"/>
                                    <Button Grid.Column="2"
                                                Content="선택 항목을 여기로 이동"
                                            Click="MoveQuickSlotToGroupButton_Click"
                                            Margin="8,0,0,0"/>
                                    <TextBlock x:Name="LayoutStatusText"
                                               Grid.Column="3"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="그룹 위치는 드래그가 끝날 때마다 저장됩니다."
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"/>
                                </Grid>

                                <Border Margin="0,0,0,12"
                                        Padding="13"
                                        CornerRadius="9"
                                        Background="#141A28"
                                        BorderBrush="#283247"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Dock 기본 항목"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Dock에 고정할 Windows 항목을 선택합니다. 휴지통은 상태가 자동 갱신되며 Dock에서 우클릭해 비울 수 있습니다."
                                                   Margin="0,4,0,10"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"/>
                                        <ItemsControl x:Name="SystemShortcutList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3,0,0"
                                                            Padding="9"
                                                            CornerRadius="7"
                                                            Background="#1A2131">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Content="{Binding Name}"
                                                                      IsChecked="{Binding ShowInDock, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"
                                                                      Checked="DockItemVisibility_Changed"
                                                                      Unchecked="DockItemVisibility_Changed"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding CustomIconPath}"
                                                                       Margin="12,0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="10"
                                                                       ToolTip="{Binding CustomIconPath}"/>
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal">
                                                            <Button Content="아이콘 선택"
                                                                        Tag="{Binding}"
                                                                        Click="ChooseSystemShortcutIconButton_Click"/>
                                                            <Button Content="Windows 아이콘 사용"
                                                                        Tag="{Binding}"
                                                                        Margin="7,0,0,0"
                                                                        Click="ResetSystemShortcutIconButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <ListBox x:Name="QuickSlotList"
                                         MinHeight="80"
                                         MaxHeight="245"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#171C2B"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="30"
                                                            Height="30"
                                                            CornerRadius="6"
                                                            Background="#183A4C">
                                                        <TextBlock Text="{Binding Slot}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Consolas"
                                                                   FontWeight="Bold"
                                                                   Foreground="#8FFAFF"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="5,0,12,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding GroupName}"
                                                                   Visibility="Collapsed"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TargetPath}"
                                                                   Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   FontSize="11"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2"
                                                              Content="고정"
                                                              Margin="8,0,14,0"
                                                              VerticalAlignment="Center"
                                                              IsChecked="{Binding ShowInDock, Mode=TwoWay}"
                                                              Checked="DockItemVisibility_Changed"
                                                              Unchecked="DockItemVisibility_Changed"/>
                                                    <Button Grid.Column="3"
                                                            Content="삭제"
                                                            Tag="{Binding}"
                                                            Click="RemoveQuickSlotButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SettingsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                                <TextBlock Text="설정" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text="재생 설정은 LocalAppData\Vellume에 로컬로 저장됩니다."
                               Margin="0,7,0,0"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="화면 맞춤" FontWeight="SemiBold" FontSize="15"/>
                        <ComboBox x:Name="FitComboBox"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Margin="0,9,0,22"
                                  SelectionChanged="FitComboBox_SelectionChanged"/>

                        <CheckBox x:Name="MuteCheckBox"
                                              Content="월페이퍼 소리 끄기"
                                  Checked="MuteCheckBox_Changed"
                                  Unchecked="MuteCheckBox_Changed"/>

                        <TextBlock Margin="0,22,0,7">
                                            <Run Text="볼륨 "/>
                            <Run x:Name="VolumeValueText" Text="25%"/>
                        </TextBlock>
                        <Slider x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                ValueChanged="VolumeSlider_ValueChanged"/>

                        <CheckBox x:Name="OptimizeVideoCheckBox"
                                  Content="영상 GPU 사용량 자동 최적화"
                                  Margin="0,24,0,0"
                                  Checked="OptimizeVideoCheckBox_Changed"
                                  Unchecked="OptimizeVideoCheckBox_Changed"/>
                        <TextBlock Text="원본은 보존하고 디스플레이 해상도에 맞는 30fps H.264 재생 캐시를 사용합니다. 첫 적용 때만 변환 시간이 필요할 수 있습니다."
                                   Margin="24,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <CheckBox x:Name="RestoreCheckBox"
                                  Content="Vellume 시작 시 마지막 월페이퍼 복원"
                                  Margin="0,26,0,0"
                                  Checked="RestoreCheckBox_Changed"
                                  Unchecked="RestoreCheckBox_Changed"/>

                        <CheckBox x:Name="LaunchAtLoginCheckBox"
                                  Content="Windows 로그인 시 Vellume 자동 실행"
                                  Margin="0,12,0,0"
                                  Checked="LaunchAtLoginCheckBox_Changed"
                                  Unchecked="LaunchAtLoginCheckBox_Changed"/>

                                    <TextBlock Text="설정과 로그는 이 컴퓨터 밖으로 전송되지 않습니다."
                                   Margin="0,28,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
