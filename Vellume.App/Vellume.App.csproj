<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vellume.Windows\Vellume.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\vellume-app.ico</ApplicationIcon>
    <!-- WPF owns startup; WinForms is used only for tray/dialog integration.
         DPI must be declared before WPF creates HWNDs, not via WinForms startup. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.9.2</Version>
    <FileVersion>0.9.2.0</FileVersion>
    <AssemblyVersion>0.9.2.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\README.md"
             Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Launcher\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Companion\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Stickers\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Brand\**\*"
             Exclude="Assets\Brand\vellume-app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Share the EXE artwork with WPF and NotifyIcon without a loose-file dependency. -->
    <Resource Include="Assets\Brand\vellume-app.ico" />
    <Content Include="..\Vellume.Renderer.Native\bin\x64\$(Configuration)\Vellume.Renderer.Native.exe"
             Link="Vellume.Renderer.Native.exe"
             Condition="Exists('..\Vellume.Renderer.Native\bin\x64\$(Configuration)\Vellume.Renderer.Native.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
