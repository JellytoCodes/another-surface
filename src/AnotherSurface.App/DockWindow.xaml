<Window x:Class="AnotherSurface.App.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Another Surface Dock"
        AllowsTransparency="False"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="DockTileStyle" TargetType="Border">
            <Setter Property="Width"
                    Value="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Height"
                    Value="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Margin" Value="4,9"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.18"
                                                 Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.18"
                                                 Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.14"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.14"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DockItemTemplate">
            <Border x:Name="DockItemRoot"
                    Style="{StaticResource DockTileStyle}"
                    Cursor="Hand"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="DockItem_PreviewMouseMove"
                    MouseLeftButtonUp="DockItem_MouseLeftButtonUp"
                    MouseRightButtonUp="DockItem_MouseRightButtonUp"
                    Drop="DockItem_Drop">
                <Grid>
                    <Border x:Name="IconFrame">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="CornerRadius" Value="15"/>
                                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="RenderOptions.BitmapScalingMode"
                                        Value="Fant"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnotherSurface}" Value="True">
                                        <Setter Property="CornerRadius" Value="30"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}"
                                        AlignmentX="Center"
                                        AlignmentY="Center"
                                        Stretch="UniformToFill"
                                        TileMode="None"/>
                        </Border.Background>
                    </Border>
                    <Border x:Name="CategoryDivider"
                            Width="1"
                            Height="42"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#66FFFFFF"
                            Visibility="Collapsed"/>
                    <Ellipse x:Name="RunningIndicator"
                             Width="7"
                             Height="7"
                             Margin="0,0,0,-6"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Center"
                             Fill="#E6F7FF"
                             Visibility="{Binding RunningVisibility}"/>
                    <Ellipse x:Name="AttentionIndicator"
                             Width="10"
                             Height="10"
                             Margin="0,-1,-1,0"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Right"
                             Fill="#FF4F81"
                             Stroke="#FFF4FA"
                             StrokeThickness="1.5"
                             Visibility="{Binding AttentionVisibility}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSeparator}"
                                 Value="True">
                        <Setter TargetName="DockItemRoot" Property="Width" Value="13"/>
                        <Setter TargetName="DockItemRoot" Property="Height" Value="42"/>
                        <Setter TargetName="DockItemRoot" Property="Margin" Value="2,0"/>
                        <Setter TargetName="DockItemRoot" Property="IsHitTestVisible" Value="False"/>
                        <Setter TargetName="IconFrame" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="CategoryDivider" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="RunningIndicator" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="AttentionIndicator" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="DockSurface"
            Margin="10"
            Padding="8,2"
            CornerRadius="22"
            Background="#68151C27"
            BorderBrush="#44DDF7FF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="4"
                              Opacity="0.28"
                              Color="#00111A"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding PinnedItems}"
                          ItemTemplate="{StaticResource DockItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border x:Name="RunningDivider"
                    Width="1"
                    Height="40"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="#55FFFFFF"
                    Visibility="{Binding RunningSectionVisibility}"/>

            <ItemsControl ItemsSource="{Binding RunningItems}"
                          ItemTemplate="{StaticResource DockItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
